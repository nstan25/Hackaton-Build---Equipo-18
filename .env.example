# Rutas compartidas fuera del repo (SPEC §3.0). Copiá a .env y ajustá si hace falta.
BCS_DATA_DIR=~/bcs-shared/data
BCS_ARTIFACTS_DIR=~/bcs-shared/artifacts
BCS_HOLDOUT_DIR=~/bcs-shared/holdout
BCS_DB_PATH=~/bcs-shared/app/bcs.sqlite
BCS_MEDIA_DIR=~/bcs-shared/app/media
# Token compartido de la demo (header X-App-Token o ?token=). Elegí uno largo y aleatorio.
BCS_APP_TOKEN=cambiame

# T17: explicación con OpenAI (la clave nunca va al repo)
OPENAI_API_KEY=
OPENAI_MODEL=
