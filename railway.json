{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "config/**",
      "web/**",
      "models/**",
      "train_cnn.py",
      "metrics.py",
      "prep_yolo.py",
      "prep_crops.py",
      "Dockerfile",
      "pyproject.toml",
      "uv.lock"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
